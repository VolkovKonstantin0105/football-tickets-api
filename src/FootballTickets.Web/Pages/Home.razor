@page "/"
@inject ApiClient Api

<PageTitle>Матчи</PageTitle>

<h1 class="mb-4">Ближайшие матчи</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <select class="form-select" @onchange="OnTeamChanged">
            <option value="">Все команды</option>
            @foreach (var team in teams)
            {
                <option value="@team.Id">@team.Name</option>
            }
        </select>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (page is null)
{
    <p>Загрузка...</p>
}
else if (page.Items.Count == 0)
{
    <p class="text-muted">Подходящих матчей нет.</p>
}
else
{
    <div class="row g-3">
        @foreach (var match in page.Items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@match.HomeTeam.Name - @match.AwayTeam.Name</h5>
                        <p class="card-text text-muted mb-1">@match.Stadium</p>
                        <p class="card-text mb-1"><LocalTime Value="match.StartsAt" /></p>
                        <p class="card-text">Базовая цена: @match.BasePrice.ToString("0.##")</p>
                        <a class="btn btn-primary" href="match/@match.Id">Выбрать места</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav class="mt-4 d-flex align-items-center gap-3">
        <button class="btn btn-outline-secondary btn-sm"
                disabled="@(pageNumber <= 1)"
                @onclick="() => GoToAsync(pageNumber - 1)">
            Назад
        </button>
        <span>Страница @pageNumber из @TotalPages</span>
        <button class="btn btn-outline-secondary btn-sm"
                disabled="@(pageNumber >= TotalPages)"
                @onclick="() => GoToAsync(pageNumber + 1)">
            Вперед
        </button>
    </nav>
}

@code {
    private List<TeamDto> teams = new();
    private PagedResult<MatchDto>? page;
    private string? error;
    private Guid? teamId;
    private int pageNumber = 1;

    private int TotalPages => page is null
        ? 1
        : Math.Max(1, (int)Math.Ceiling(page.TotalCount / (double)page.PageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            teams = await Api.GetTeamsAsync() ?? new();
        }
        catch (Exception)
        {
            error = "Не удалось загрузить данные. Попробуйте обновить страницу.";
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            error = null;
            page = null;
            page = await Api.GetMatchesAsync(pageNumber, teamId);
        }
        catch (Exception)
        {
            error = "Не удалось загрузить матчи. Попробуйте обновить страницу.";
        }
    }

    private async Task OnTeamChanged(ChangeEventArgs e)
    {
        teamId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task GoToAsync(int number)
    {
        pageNumber = number;
        await LoadAsync();
    }
}
