@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Вход</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Вход</h1>

        @if (error is not null)
        {
            <div class="alert alert-danger">@error</div>
        }

        <EditForm Model="model" OnValidSubmit="SubmitAsync">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="model.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Пароль</label>
                <InputText type="password" class="form-control" @bind-Value="model.Password" />
            </div>
            <button class="btn btn-primary" disabled="@busy">Войти</button>
            <a class="ms-3" href="register">Нет аккаунта?</a>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginModel model = new();
    private string? error;
    private bool busy;

    private async Task SubmitAsync()
    {
        busy = true;
        error = await Auth.LoginAsync(model.Email, model.Password);
        busy = false;
        if (error is null) Nav.NavigateTo("");
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
