      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FootballTickets.Application\FootballTickets.Application.csproj" />
    <ProjectReference Include="..\FootballTickets.Infrastructure\FootballTickets.Infrastructure.csproj" />
  </ItemGroup>

</Project>
